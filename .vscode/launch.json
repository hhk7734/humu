{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Server",
			"type": "debugpy",
			"request": "launch",
			"module": "humu",
			"args": ["serve"],
			"console": "integratedTerminal"
		},
		{
			"name": "Client",
			"type": "debugpy",
			"request": "launch",
			"module": "humu",
			"console": "integratedTerminal"
		}
	],
	"compounds": [
		{
			"name": "Server + Client",
			"configurations": ["Server", "Client"],
			"stopAll": true
		}
	]
}
